COMPOSE_PROJECT_NAME=ai-cloud

APP_PORT=80
BACKEND_PORT=8080

MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=ai_cloud

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

ATTU_PORT=8000

SERVER_PORT=8080
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=ai_cloud

JWT_SECRET=change-me
JWT_EXPIRATION_HOURS=24

STORAGE_TYPE=minio
STORAGE_LOCAL_BASE_DIR=/app/storage_data
STORAGE_MINIO_ENDPOINT=minio:9000
STORAGE_MINIO_BUCKET=ai-cloud
STORAGE_MINIO_ACCESS_KEY_ID=minioadmin
STORAGE_MINIO_ACCESS_KEY_SECRET=minioadmin
STORAGE_MINIO_USE_SSL=false
STORAGE_MINIO_REGION=

MILVUS_ADDRESS=standalone:19530
MILVUS_INDEX_TYPE=IVF_FLAT
MILVUS_METRIC_TYPE=COSINE
MILVUS_NLIST=128
MILVUS_NPROBE=16
MILVUS_ID_MAX_LENGTH=64
MILVUS_CONTENT_MAX_LENGTH=65535
MILVUS_DOC_ID_MAX_LENGTH=64
MILVUS_DOC_NAME_MAX_LENGTH=256
MILVUS_KB_ID_MAX_LENGTH=64

RAG_CHUNK_SIZE=1500
RAG_OVERLAP_SIZE=500

CORS_ALLOW_ORIGINS=http://localhost,http://localhost:80
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Origin,Content-Type,Accept,Authorization
CORS_EXPOSE_HEADERS=Content-Length
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=12h

LLM_API_KEY=replace-with-your-key
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MAX_TOKENS=10240
LLM_TEMPERATURE=0.7
